{
  "name": "playwright_portfolio_automation_typescript",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:ui": "npx playwright test --ui",
    "test:chrome": "npx playwright test --project=chromium",
    "test:firefox": "npx playwright test --project=firefox",
    "test:webkit": "npx playwright test --project=webkit",
    "test:debug": "npx playwright test --debug",
    "test:smoke": "npx playwright test --grep @smoke",
    "report": "npx playwright show-report",
    "docker:build": "docker build -t playwright-portfolio-tests .",
    "docker:run": "docker run --rm -v ${PWD}/playwright-report:/app/playwright-report -v ${PWD}/test-results:/app/test-results playwright-portfolio-tests",
    "docker:compose:up": "docker-compose up --build",
    "docker:compose:down": "docker-compose down",
    "ci": "npx playwright test --reporter=html,json,junit",
    "mcp:playwright": "npx playwright-mcp",
    "mcp:playwright:headless": "npx playwright-mcp --headless --browser chromium"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cng07/playwright_portfolio_automation_typescript.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/cng07/playwright_portfolio_automation_typescript/issues"
  },
  "homepage": "https://github.com/cng07/playwright_portfolio_automation_typescript#readme",
  "devDependencies": {
    "@playwright/mcp": "^0.0.68",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.2.2"
  },
  "dependencies": {
    "@fast-csv/parse": "^5.0.5",
    "fast-csv": "^5.0.5"
  }
}
